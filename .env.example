# Optional Alternative Cloud & Self-Hosted AI Provider Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Self-Hosted / Local LLM (Ollama, vLLM, LocalAI with Gemma, DeepSeek-R1, Llama)
CUSTOM_LLM_BASE_URL=http://localhost:11434/v1
CUSTOM_LLM_MODEL=gemma2:9b
CUSTOM_LLM_API_KEY=

# Database Connection (PostgreSQL, MySQL, Supabase, Neon, Cloud SQL, etc.)
# Provide either a full connection URL:
DATABASE_URL=postgresql://postgres:password@localhost:5432/resume_matcher_db
# OR individual connection fields:
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=resume_matcher_db
DB_SSL=false

