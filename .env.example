# Environment Variables

# Primary AI Key (Server-side Gemini)
GEMINI_API_KEY=

# Optional Alternative Cloud & Self-Hosted AI Provider Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Self-Hosted / Local LLM (Ollama, vLLM, LocalAI with Gemma, DeepSeek-R1, Llama)
# Use an OpenAI-compatible base URL reachable from the server process.
# For Docker, localhost points to the app container; use the host/service network address instead.
CUSTOM_LLM_BASE_URL=http://localhost:11434/v1
CUSTOM_LLM_MODEL=gemma2:9b
CUSTOM_LLM_API_KEY=
# Only enable for a trusted self-hosted endpoint using a self-signed certificate.
# Prefer a CA-signed certificate in production.
CUSTOM_LLM_ALLOW_INSECURE_TLS=false

# Shared PostgreSQL connection
# Local development uses 127.0.0.1:5433. Docker Compose overrides the host
# to global-postgres on the shared Docker network.
DB_TYPE=postgresql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=global_admin
DB_PASSWORD=replace-with-the-value-from-../../databases_and_storages/secrets/postgres_password
DB_NAME=postgres
DB_SSL=false

# TON Network Wallet & Cryptocurrency Billing Configuration
TON_NETWORK=mainnet
TON_RECIPIENT_WALLET=EQB_v0_4T6i5m8c0P5hE39Hk3q91Nf0xL6wP5R0U4M3V2TON
TON_USDT_JETTON_MASTER=EQCxE6mUtQJKFnGfaROTKOtAhEvRmUyO1m-H_TeRNYWgQEMS
TON_DAILY_PASS_USDT=1.0
TON_DAILY_PASS_TON=0.25

# Admin Access Configuration (Unlimited lifetime features)
ADMIN_EMAIL=alimohammadnia127@gmail.com
ADMIN_TELEGRAM_ID=
ADMIN_SECRET_KEY=
